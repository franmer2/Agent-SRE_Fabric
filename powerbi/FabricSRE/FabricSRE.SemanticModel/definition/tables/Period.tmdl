table Period

	column Days
		dataType: int64
		isKey
		summarizeBy: none
		sourceColumn: Days

	column Label
		dataType: string
		sortByColumn: Days
		sourceColumn: Label

	partition Period = m
		mode: import
		source =
			#table(
				type table [Days = Int64.Type, Label = text],
				{{7, "7 days"}, {30, "30 days"}, {60, "60 days"}}
			)

